# Copy to .env and fill in. .env is gitignored.

# --- LLM provider -----------------------------------------------------------
# openai | anthropic | google | openai-compatible | mock   (case-insensitive)
# "mock" needs no key and returns canned output; tests always use it.
API_PROVIDER=openai
API_KEY=

# Only for openai-compatible (OpenRouter, Groq, Together, Ollama, ...).
API_BASE_URL=

# Optional per-role model overrides. Blank = the provider's default (src/config.ts).
MODEL_GENERATOR=
MODEL_ORCHESTRATOR=
MODEL_SUBAGENT=
MODEL_JUDGE=

# --- Embeddings (10-K index) --------------------------------------------------
# Blank = same provider and key as above. Anthropic has no embedding model,
# so set these if API_PROVIDER=anthropic.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Data -----------------------------------------------------------------------
# snapshot = read a dated JSON file; live = fetch from the provider.
# Evals always force snapshot, whatever is set here.
DATA_MODE=snapshot
# Optional per-source overrides of DATA_MODE.
FUNDAMENTALS_MODE=
NEWS_MODE=
# Snapshot date evals pin (YYYY-MM-DD). Blank = the latest snapshot on disk.
SNAPSHOT_DATE=
# Data provider keys (provider chosen in Increment 1).
FUNDAMENTALS_API_KEY=
NEWS_API_KEY=

# --- Run caps -------------------------------------------------------------------
MAX_STEPS=15
MAX_TOKENS_PER_CASE=200000
